# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
indent_size = 4
end_of_line = crlf

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
